    <string name="sec_posting">Posting</string>
    <string name="pref_posting">Allow posting</string>
    <string name="pref_posting_note">Turns on the compose button: write a post, add a story, go live, or list something on Marketplace. Watching other people\'s Reels and Stories stays blocked either way.</string>

    <string name="sec_blocking">Blocking</string>
    <string name="pref_hide">Hide feed links inside pages</string>
    <string name="pref_reels">Allow single Reels from notifications</string>
    <string name="pref_groups">Allow single group posts</string>
    <string name="pref_external">Open outside links in your browser</string>
    <string name="pref_toasts">Show a banner when something is blocked</string>
    <string name="sec_blocking_note">Feeds, Reels, Watch, Stories, Explore, and other people\'s profiles are always blocked. These switches only fine-tune the edges.</string>

    <string name="sec_site">Site mode</string>
    <string name="pref_desktop_fb">Desktop site for Facebook</string>
    <string name="pref_desktop_ig">Desktop site for Instagram</string>
    <string name="pref_width">Desktop page width</string>
    <string name="sec_site_note">Facebook\'s mobile site refuses to show Messenger, so Facebook uses the desktop site. Page width controls how much the desktop layout is shrunk to fit the phone. Narrower means bigger text. You can also pinch to zoom.</string>

