    <string name="sec_posting">Posting</string>
    <string name="pref_posting">Allow posting</string>
    <string name="pref_posting_note">Turns on the compose button, so you can write a post, add a story, go live, or sell something on Marketplace.</string>

    <string name="sec_posts">Posts</string>
    <string name="pref_open_tapped">Open other people\'s posts I tap</string>
    <string name="pref_open_tapped_note">Your own posts, Reels, videos, and stories always open. With this on, a post you tap opens too, so you can read it and reply. It never moves on to the next one. Swiping or autoplay into another post is blocked. Turn this off to open only your own posts.</string>

